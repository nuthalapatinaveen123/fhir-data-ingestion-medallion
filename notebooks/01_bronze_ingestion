import os
import json
import logging
import time
import uuid
from datetime import datetime
import requests
from pyspark.sql.types import StringType, StructField, StructType

# Setup logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("fhir_ingestion")

# Configuration
BASE_URL = "https://hapi.fhir.org/baseR4"
RESOURCES = ["Patient", "Encounter", "Condition", "Observation"]
RAW_PATH = "/lakehouse/default/Files/raw"
MAX_PAGES = 3
PAGE_SIZE = 50
BATCH_ID = str(uuid.uuid4())

logger.info(f"Starting ingestion run with batch ID: {BATCH_ID}")


def get_fhir_data(url, max_retries=3):
    """Fetch FHIR payloads with exponential backoff for rate limits."""
    headers = {"Accept": "application/fhir+json"}
    
    for attempt in range(max_retries):
        try:
            res = requests.get(url, headers=headers, timeout=15)
            if res.status_code == 200:
                return res.json()
            logger.warning(f"Got status code {res.status_code} for {url}. Retrying...")
        except requests.RequestException as err:
            logger.warning(f"Request failed: {err}. Retrying...")
            
        time.sleep(2 ** (attempt + 1))
        
    raise RuntimeError(f"Could not fetch data from {url} after {max_retries} attempts.")


def process_resource(resource_type):
    url = f"{BASE_URL}/{resource_type}?_count={PAGE_SIZE}&_sort=-_lastUpdated"
    records = []
    page = 0
    now = datetime.utcnow()
    date_folder = now.strftime("year=%Y/month=%m/day=%d")
    
    logger.info(f"Ingesting {resource_type} resources...")

    while url and page < MAX_PAGES:
        payload = get_fhir_data(url)
        entries = payload.get("entry", [])
        
        for item in entries:
            res = item.get("resource", {})
            res_id = res.get("id")
            
            if res_id:
                records.append({
                    "resource_id": str(res_id),
                    "raw_json": json.dumps(res),
                    "extraction_timestamp": now.isoformat(),
                    "api_url_or_params": url,
                    "source_system": "HAPI_FHIR_API",
                    "ingestion_batch_id": BATCH_ID
                })

        # Grab next page link from payload
        url = next((l["url"] for l in payload.get("link", []) if l.get("relation") == "next"), None)
        page += 1

    if not records:
        logger.warning(f"No records found for {resource_type}.")
        return 0

    # Dump raw JSON output to Lakehouse Files
    out_dir = f"{RAW_PATH}/{resource_type}/{date_folder}"
    os.makedirs(out_dir, exist_ok=True)
    
    file_path = f"{out_dir}/batch_{BATCH_ID}.json"
    with open(file_path, "w", encoding="utf-8") as f:
        json.dump([r["raw_json"] for r in records], f)
        
    logger.info(f"Saved raw JSON payload to {file_path}")

    # Write to Bronze Delta Lake
    schema = StructType([
        StructField("resource_id", StringType(), False),
        StructField("raw_json", StringType(), False),
        StructField("extraction_timestamp", StringType(), False),
        StructField("api_url_or_params", StringType(), False),
        StructField("source_system", StringType(), False),
        StructField("ingestion_batch_id", StringType(), False)
    ])

    df = spark.createDataFrame(records, schema=schema)
    table_name = f"bronze_{resource_type.lower()}"
    
    df.write \
        .format("delta") \
        .mode("append") \
        .option("mergeSchema", "true") \
        .saveAsTable(table_name)
        
    logger.info(f"Appended {len(records)} rows to {table_name}")
    return len(records)


# Main loop
results = {}
for res in RESOURCES:
    count = process_resource(res)
    results[res] = count

logger.info("=== Ingestion Summary ===")
for res, count in results.items():
    logger.info(f"bronze_{res.lower()}: {count} records")
