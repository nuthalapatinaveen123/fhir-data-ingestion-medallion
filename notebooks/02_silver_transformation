import logging
from delta.tables import DeltaTable
from pyspark.sql.functions import (
    col, from_json, schema_of_json, lit,
    sha2, element_at, split, get_json_object, coalesce
)

# Enable auto-schema evolution for Delta merges
spark.conf.set("spark.databricks.delta.schema.autoMerge.enabled", "true")

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("silver_transformation")

RESOURCES = ["Patient", "Encounter", "Condition", "Observation"]


def process_silver_scd2(resource_type, key_col="resource_id"):
    bronze_tbl = f"bronze_{resource_type.lower()}"
    silver_tbl = f"silver_{resource_type.lower()}"

    # Verify bronze data exists before attempting transformations
    if not spark.catalog.tableExists(bronze_tbl) or spark.read.table(bronze_tbl).isEmpty():
        logger.warning(f"Bronze table '{bronze_tbl}' is missing or empty. Skipping...")
        if not spark.catalog.tableExists(silver_tbl):
            spark.sql(f"""
                CREATE TABLE IF NOT EXISTS {silver_tbl} (
                    resource_id STRING,
                    patient_id_ref STRING,
                    valid_from STRING,
                    valid_to STRING,
                    is_current BOOLEAN,
                    row_hash STRING
                ) USING DELTA
            """)
        return

    bronze_df = spark.read.table(bronze_tbl)

    # Extract patient reference key from payload
    df_with_ref = bronze_df.withColumn(
        "patient_id_ref",
        element_at(
            split(
                coalesce(
                    get_json_object(col("raw_json"), "$.subject.reference"),
                    get_json_object(col("raw_json"), "$.patient.reference")
                ),
                "/"
            ),
            -1
        )
    )

    # Infer JSON schema dynamically using first payload sample
    sample_json = bronze_df.select("raw_json").first()[0]
    payload_schema = schema_of_json(sample_json)

    # Flatten top-level JSON fields and set metadata
    parsed_df = df_with_ref \
        .withColumn("data", from_json(col("raw_json"), payload_schema)) \
        .select(
            col("resource_id"),
            col("patient_id_ref"),
            col("data.*"),
            col("extraction_timestamp"),
            col("raw_json")
        ) \
        .withColumn("row_hash", sha2(col("raw_json"), 256)) \
        .withColumn("valid_from", col("extraction_timestamp")) \
        .withColumn("valid_to", lit(None).cast("string")) \
        .withColumn("is_current", lit(True)) \
        .dropDuplicates([key_col, "row_hash"])

    # Initial write if target table does not exist yet
    if not spark.catalog.tableExists(silver_tbl):
        parsed_df.drop("raw_json") \
            .write \
            .format("delta") \
            .mode("overwrite") \
            .saveAsTable(silver_tbl)
        return

    # Handle SCD Type 2 merge logic
    target_delta = DeltaTable.forName(spark, silver_tbl)
    target_df = target_delta.toDF()

    # Identify existing active records that changed in incoming batch
    changed_records = parsed_df.alias("src").join(
        target_df.alias("tgt"),
        on=(col(f"src.{key_col}") == col(f"tgt.{key_col}")) & col("tgt.is_current"),
        how="inner"
    ).filter(
        col("src.row_hash") != col("tgt.row_hash")
    ).select(
        col(f"src.{key_col}").alias("join_key"),
        col("src.*")
    )

    # Union new inserts and modified records for two-pass merge execution
    staged_df = parsed_df.drop("raw_json").withColumn("join_key", lit(None).cast("string")) \
        .unionByName(changed_records.drop("raw_json"), allowMissingColumns=True)

    # Execute Delta merge (updates modified rows to historical, inserts new current rows)
    target_delta.alias("tgt").merge(
        staged_df.alias("src"),
        f"tgt.{key_col} = src.join_key AND tgt.is_current = true"
    ).whenMatchedUpdate(
        set={"is_current": "false", "valid_to": "src.valid_from"}
    ).whenNotMatchedInsertAll().execute()

    logger.info(f"Successfully processed Silver SCD2 merge for {silver_tbl}")


# Main execution run
for resource in RESOURCES:
    process_silver_scd2(resource)
